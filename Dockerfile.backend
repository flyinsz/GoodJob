# syntax=docker/dockerfile:1.7
# Builds synced GoodJob source from this GitHub mirror inside GitHub Actions.
ARG SOURCE_REPO=https://github.com/flyinsz/GoodJob.git
ARG SOURCE_REF=main
ARG SOURCE_REV=unknown

FROM node:20-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY integration-sdk/package.json integration-sdk/package.json
COPY integration-worker/package.json integration-worker/package.json
COPY goodjob-runner/package.json goodjob-runner/package.json
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM deps AS build
WORKDIR /app
COPY . .
RUN npm run build --workspace @goodjob/integration-connector-sdk && npm run build --workspace backend

FROM node:20-bookworm-slim AS runtime
ARG SOURCE_REPO
ARG SOURCE_REF
ARG SOURCE_REV
LABEL org.opencontainers.image.source="${SOURCE_REPO}" \
      org.opencontainers.image.revision="${SOURCE_REV}" \
      org.opencontainers.image.ref.name="${SOURCE_REF}"
WORKDIR /app
ENV NODE_ENV=production \
    CRM_STORE=mysql \
    PORT=4188
# Chromium deps for optional whatsapp-web.js flows. Kept in runtime for feature compatibility.
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium ca-certificates fonts-liberation libnss3 libatk-bridge2.0-0 libgtk-3-0 libx11-xcb1 libgbm1 \
  && rm -rf /var/lib/apt/lists/*
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY integration-sdk/package.json integration-sdk/package.json
COPY integration-worker/package.json integration-worker/package.json
COPY goodjob-runner/package.json goodjob-runner/package.json
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund --workspace backend
COPY --from=build /app/backend/dist backend/dist
COPY --from=build /app/integration-sdk/dist integration-sdk/dist
COPY agent-knowledge agent-knowledge
COPY agent-skills agent-skills
EXPOSE 4188
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:4188/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "backend/dist/server.js"]
