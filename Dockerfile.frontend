# syntax=docker/dockerfile:1.7
# Builds synced GoodJob source from this GitHub mirror inside GitHub Actions.
ARG SOURCE_REPO=https://github.com/flyinsz/GoodJob.git
ARG SOURCE_REF=main
ARG SOURCE_REV=unknown

FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY integration-sdk/package.json integration-sdk/package.json
COPY integration-worker/package.json integration-worker/package.json
COPY goodjob-runner/package.json goodjob-runner/package.json
RUN npm ci
COPY . .
RUN npm run build --workspace @goodjob/integration-connector-sdk && npm run build --workspace frontend

FROM nginx:1.27-alpine
ARG SOURCE_REPO
ARG SOURCE_REF
ARG SOURCE_REV
LABEL org.opencontainers.image.source="${SOURCE_REPO}" \
      org.opencontainers.image.revision="${SOURCE_REV}" \
      org.opencontainers.image.ref.name="${SOURCE_REF}"
COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
